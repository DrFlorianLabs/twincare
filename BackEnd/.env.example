# Local development only. Spring does not load this file automatically.
JDBC_DATABASE_URL=jdbc:postgresql://localhost:5432/twincare
JDBC_DATABASE_USERNAME=twincare
JDBC_DATABASE_PASSWORD=local-development-only
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32
JWT_EXPIRATION_MS=3600000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3001
PATIENT_INVITATION_TOKEN_PEPPER=CHANGE_ME_GENERATE_A_DISTINCT_SECRET_WITH_OPENSSL_RAND_BASE64_32
PATIENT_CORS_ALLOWED_ORIGINS=http://localhost:3000
PATIENT_SESSION_COOKIE_SECURE=false
FILE_UPLOAD_DIR=./data/uploads
FILE_MAX_SIZE_BYTES=10485760
PREPARATION_ATTACHMENT_STORAGE_DIR=./runtime/preparation-attachments
PREPARATION_MULTIPART_TEMP_DIR=./runtime/private-multipart
PREPARATION_ATTACHMENT_MAX_SIZE_BYTES=10485760
SPRINGDOC_ENABLED=false

