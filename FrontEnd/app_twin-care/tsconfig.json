{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "src/App.vue",
    "src/main.js",
    "src/security/**/*.js",
    "src/services/patientAccessService.js",
    "src/usecases/**/*.js",
    "src/**/*.d.ts"
  ],
  "exclude": [
    "src/**/*.test.js"
  ],
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
