# Same-origin API is the production default. Set only for an explicitly approved deployment.
VITE_API_BASE_URL=

# Local Vite proxy target.
VITE_DEV_PROXY_TARGET=http://localhost:8080

# HTTPS patient entry point. HTTP is accepted only for local loopback development.
# Query strings, fragments and credentials are rejected.
VITE_PATIENT_PREPARATION_URL=http://localhost:5174/
